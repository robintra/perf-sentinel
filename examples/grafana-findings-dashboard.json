          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Signature"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Energy backends",
      "description": "GET /api/energy, one row per energy or intensity backend in precedence order: whether it is configured from the [green] section frozen at startup, seconds since its last successful scrape, and its success and failure counts since daemon start. The age and the counts are omitted rather than zeroed for a backend that is not configured or not scraped (cloud_energy, electricity_maps), so an empty cell means not applicable and a 0 means fresh. A configured backend reads age 0 with 0 successes during its first scrape interval: not scraped yet, not fresh. With every row unconfigured, carbon figures come from the built-in I/O proxy.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/energy",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "backends",
          "columns": [
            {
              "selector": "backend",
              "text": "Backend",
              "type": "string"
            },
            {
              "selector": "configured",
              "text": "Configured",
              "type": "boolean"
            },
            {
              "selector": "last_scrape_age_seconds",
              "text": "Last scrape age (s)",
              "type": "number"
            },
            {
              "selector": "scrapes_ok",
              "text": "Scrapes OK",
              "type": "number"
            },
            {
              "selector": "scrapes_failed",
              "text": "Scrapes failed",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Incidents",
      "description": "GET /api/incidents, newest first, one row per incident your alerting posted, opt-in through [daemon.incidents]. The time picker does not filter this table: the route has no time filter, so it always lists the 50 most recent incidents whatever the range. 'Findings' is how many rows the daemon froze for [Window from, Window to], a window that closes two trace TTLs after the incident so the traces live at the crash are inside it once analysed. 'Capture' reads Ring reached (oldest_finding_ms) against Window from: complete when the ring still reached below the window, partial when it had already evicted part of it (the NDJSON archive may still answer), empty ring when nothing was retained. 'Ended' stays blank while the alert is still firing. Click a row to load its findings in the table below, which sets the Incident variable. The datasource sends [daemon] read_api_key as X-API-Key, never the key Alertmanager posts with. Columns keep this order through an organize transformation.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/incidents?limit=50",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "$map($, function($i) {{\"id\": $i.id, \"service\": $i.service, \"kind\": $i.kind, \"at_ms\": $i.at_ms, \"ended_at_ms\": $i.ended_at_ms, \"window_from_ms\": $i.window_from_ms, \"window_to_ms\": $i.window_to_ms, \"oldest_finding_ms\": $i.oldest_finding_ms, \"findings_count\": $count($i.findings), \"capture\": $exists($i.oldest_finding_ms) ? ($i.oldest_finding_ms <= $i.window_from_ms ? \"complete\" : \"partial\") : \"empty ring\", \"detail\": $i.detail}})",
          "columns": [
            {
              "selector": "at_ms",
              "text": "Started",
              "type": "timestamp_epoch"
            },
            {
              "selector": "service",
              "text": "Service",
              "type": "string"
            },
            {
              "selector": "kind",
              "text": "Kind",
              "type": "string"
            },
            {
              "selector": "ended_at_ms",
              "text": "Ended",
              "type": "timestamp_epoch"
            },
            {
              "selector": "window_from_ms",
              "text": "Window from",
              "type": "timestamp_epoch"
            },
            {
              "selector": "window_to_ms",
              "text": "Window to",
              "type": "timestamp_epoch"
            },
            {
              "selector": "findings_count",
              "text": "Findings",
              "type": "number"
            },
            {
              "selector": "oldest_finding_ms",
              "text": "Ring reached",
              "type": "timestamp_epoch"
            },
            {
              "selector": "capture",
              "text": "Capture",
              "type": "string"
            },
            {
              "selector": "detail",
              "text": "Detail",
              "type": "string"
            },
            {
              "selector": "id",
              "text": "Id",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "links": [
            {
              "title": "Show this incident's findings",
              "url": "/d/perf-sentinel-findings?${__url_time_range}&var-DS_INFINITY=${DS_INFINITY}&var-limit=${limit}&var-include_acked=${include_acked}&var-incident=${__data.fields.Id}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Capture"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "complete": {
                        "color": "green",
                        "index": 0
                      },
                      "partial": {
                        "color": "orange",
                        "index": 1
                      },
                      "empty ring": {
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Findings"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Started",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Started": 0,
              "Service": 1,
              "Kind": 2,
              "Ended": 3,
              "Window from": 4,
              "Window to": 5,
              "Findings": 6,
              "Ring reached": 7,
              "Capture": 8,
              "Detail": 9,
              "Id": 10
            },
            "renameByName": {}
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Incident findings",
      "description": "The findings frozen for the incident selected above (variable Incident), read from GET /api/incidents with the same limit as the Incidents table, so a clicked row is always found. One row per signature folded over the incident's window alone, so Traces and First seen describe the window and not the whole ring. Frozen at reception and merged once by the settle pass, which can add rows and raise counts but never remove. A First seen later than the incident's Started is a row that fired only after the restart. No data until a row of the Incidents table is clicked or the Incident variable holds an id, and the time picker plays no part in it, the route has no time filter. The datasource sends [daemon] read_api_key as X-API-Key. Est. impact and the column order follow the Findings table above.",
