{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus instance scraping the perf-sentinel daemon /metrics endpoint.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "bargauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "heatmap",
      "name": "heatmap",
      "version": ""
    },
    {
      "type": "panel",
      "id": "piechart",
      "name": "piechart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "timeseries",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "I/O ops rate by service",
      "description": "Database queries and outbound HTTP calls made by each instrumented service, per second. This is the raw workload perf-sentinel measures, before any judgement about whether the calls were needed. Use it to see which service dominates I/O: a service that is loud here and also appears in the findings panels is where optimisation pays most.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(perf_sentinel_service_io_ops_total{job=~\"$job\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "title": "Top 10 finding types by severity",
      "description": "A finding is one detected inefficiency, for example an N+1 loop (the same query repeated once per row instead of a single batched one). This ranks the most frequent kinds This ranks the most frequent kinds over the selected time range. Rising counts mean either new traffic reaching an unoptimised path, or a recent deploy that regressed.",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (type, severity) (increase(perf_sentinel_findings_total{job=~\"$job\"}[$__range])))",
          "legendFormat": "{{type}} ({{severity}})",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "title": "I/O waste ratio",
      "description": "Share of analysed I/O operations attributed to avoidable anti-patterns, over the selected time range and summed across every replica. Derived from the two counters rather than read off the `perf_sentinel_io_waste_ratio` gauge: that gauge is a ratio of lifetime counters, so it ignores the time picker, dilutes a current problem in everything since the pod started, and renders one dial per replica. Two decimals because a fleet doing 1% avoidable I/O on a million operations is worth seeing, and integer percent would round it to zero.",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(perf_sentinel_avoidable_io_ops{job=~\"$job\"}[$__range]))\n/\nsum(increase(perf_sentinel_total_io_ops{job=~\"$job\"}[$__range]))",
          "refId": "A",
          "legendFormat": "waste ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.15
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "title": "Critical findings",
      "description": "Findings the analyzer rated critical, over the selected time range. Severity comes from how far the pattern exceeds its detection threshold, not from user impact, so a critical finding is a strong optimisation candidate rather than an outage. Shows 0 rather than 'no data' when none were emitted, so a flat zero line means healthy and not broken.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(perf_sentinel_findings_total{job=~\"$job\", severity=\"critical\"}[$__range])) or vector(0)",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Findings distribution by type",
      "description": "The same findings as the ranking panel, shown as a share of the whole. Answers 'what kind of problem does this system mostly have'. A single type dominating usually points at one framework or one query pattern rather than at a broad problem.",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(perf_sentinel_findings_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active traces",
      "description": "Distributed traces currently held in memory waiting to be completed. A trace is released for analysis once it expires (30s by default) or the window is full. A stable plateau is healthy. Continuous growth means traces arrive faster than they expire, and the cap will start dropping the oldest ones, see the headroom panel.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_active_traces{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Slow span duration p95 by kind",
      "description": "95th percentile duration of spans that crossed the slow threshold (500 ms by default, configurable). Only slow spans enter this histogram, so the value is always above that threshold by construction and is not your overall latency. Split by kind: sql, http_out and messaging. Aggregated with histogram_quantile so it stays correct across sharded daemons.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(perf_sentinel_slow_duration_seconds_bucket{job=~\"$job\", type=\"sql\"}[$__rate_interval])))",
          "legendFormat": "SQL p95 {{instance}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(perf_sentinel_slow_duration_seconds_bucket{job=~\"$job\", type=\"http_out\"}[$__rate_interval])))",
          "legendFormat": "HTTP p95 {{instance}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(perf_sentinel_slow_duration_seconds_bucket{job=~\"$job\", type=\"messaging\"}[$__rate_interval])))",
          "legendFormat": "Messaging p95 {{instance}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "Events processed rate",
      "description": "Spans accepted into the analysis pipeline per second, after non-I/O spans have been filtered out. Compare with the OTLP intake panel: a large gap between the two is normal, most spans in a trace are not I/O. A drop to zero while intake continues means the pipeline stopped consuming.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(perf_sentinel_events_processed_total{job=~\"$job\"}[$__rate_interval])",
          "legendFormat": "events/s {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "title": "Total findings (cumulative)",
      "description": "Grand total of findings emitted by the daemon since start, summed across all types and severities. Pairs with the per-type / per-severity panels to give a single at-a-glance number.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(perf_sentinel_findings_total{job=~\"$job\"}) or vector(0)",
          "legendFormat": "total {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "title": "Slow span duration distribution",
      "description": "Heatmap of slow span buckets over time, complementing the global p95 panel with the full duration distribution. Hot bands above the p95 line indicate tail latency drift.",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (le) (rate(perf_sentinel_slow_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "Findings detail by type and severity",
      "description": "Tabular breakdown of finding counts grouped by (type, severity) over the selected time range, the same window as the ranking and distribution panels beside it, so the three never contradict each other. Useful for raw triage, copy-paste into tickets, and comparing relative magnitude across detection categories side by side. The cumulative grand total since daemon start is the 'Total findings (cumulative)' stat.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (type, severity) (increase(perf_sentinel_findings_total{job=~\"$job\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "displayMode": "color-background",
            "align": "left"
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Daemon health",
      "description": "up{} for the perf-sentinel daemon scrape job. 0 means Prometheus cannot reach /metrics. Adjust the job label to match your ServiceMonitor / scrape_configs naming.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "up{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "title": "Total I/O ops processed",
      "description": "Cumulative count of analysed I/O operations since the daemon started. A sanity counter rather than a diagnostic: if it stops climbing while traffic continues, ingestion or analysis has stalled. It resets on restart.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_total_io_ops{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "title": "Traces analyzed (cumulative)",
      "description": "Traces that completed analysis since daemon start. Trace-level cadence, where 'events processed' is span-level. The ratio between the two gives the average trace size, which is a useful sanity check on your instrumentation coverage.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_traces_analyzed_total{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "title": "Avoidable I/O ops rate",
      "description": "Operations per second that the analyzer marked as avoidable, meaning the same result could have been obtained with fewer calls. This is the GreenOps trend signal: unlike the cumulative waste ratio it reacts immediately, so it is the panel that shows an optimisation PR landing.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(perf_sentinel_avoidable_io_ops{job=~\"$job\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "avoidable ops/s {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "title": "Energy ingestion freshness",
      "description": "Seconds since each CONFIGURED energy backend last returned a sample. A backend you did not configure draws nothing at all: its series is gated on perf_sentinel_energy_backend_configured, because every energy gauge is pre-registered at zero and a successful scrape also sets the staleness gauge to zero, so without the gate 'not configured' and 'healthy' were the same flat line and an unconfigured install drew five of them per replica. Zero therefore means fresh. When an age climbs past its scrape interval the readings are stale and carbon attribution silently falls back to the built-in estimate, so the numbers stay plausible while no longer being measured.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_alumet_last_scrape_age_seconds{job=~\"$job\"}\n  and on(job, instance)\n(perf_sentinel_energy_backend_configured{job=~\"$job\", backend=\"alumet\"} == 1)",
          "legendFormat": "alumet {{instance}}",
          "refId": "A"
        },
        {
          "expr": "perf_sentinel_scaphandre_last_scrape_age_seconds{job=~\"$job\"}\n  and on(job, instance)\n(perf_sentinel_energy_backend_configured{job=~\"$job\", backend=\"scaphandre\"} == 1)",
          "refId": "B",
          "legendFormat": "scaphandre {{instance}}"
        },
        {
          "expr": "perf_sentinel_kepler_last_scrape_age_seconds{job=~\"$job\"}\n  and on(job, instance)\n(perf_sentinel_energy_backend_configured{job=~\"$job\", backend=\"kepler\"} == 1)",
          "legendFormat": "kepler {{instance}}",
          "refId": "C"
        },
        {
          "expr": "perf_sentinel_redfish_last_scrape_age_seconds{job=~\"$job\"}\n  and on(job, instance)\n(perf_sentinel_energy_backend_configured{job=~\"$job\", backend=\"redfish\"} == 1)",
          "legendFormat": "redfish {{instance}}",
          "refId": "D"
        },
        {
          "expr": "perf_sentinel_cloud_energy_last_scrape_age_seconds{job=~\"$job\"}\n  and on(job, instance)\n(perf_sentinel_energy_backend_configured{job=~\"$job\", backend=\"cloud_energy\"} == 1)",
          "refId": "E",
          "legendFormat": "cloud_energy {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No measured-energy backend configured. Carbon figures come from the built-in I/O proxy. See docs/ENERGY.md to plug in Alumet, Scaphandre, Kepler, Redfish or cloud SPECpower."
        }
      }
    },
    {
      "title": "Report exports rate",
      "description": "rate(perf_sentinel_export_report_requests_total). Tracks how often /api/export/report is consumed (CI snapshots, dev triage, daemon-Report to local-batch path).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(perf_sentinel_export_report_requests_total{job=~\"$job\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "exports/s {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "title": "Energy per scoring window (kWh)",
      "description": "Electricity attributed to the analysed workload for the most recent scoring window. Depending on configuration this is measured (an agent reading real power) or modelled from operation counts, and the report's model tag says which. Per-service and per-region detail is deliberately kept off /metrics to bound label cardinality, it lives in the query monitor.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 60
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_energy_kwh{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "energy {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Carbon per scoring window (gCO2e)",
      "description": "Operational emissions for the same window, summed across regions: energy multiplied by the local grid intensity. It moves with the workload but also with the grid, so a drop is not necessarily an optimisation, it can just be a cleaner hour. Manufacturing emissions are excluded here, fixing code does not un-manufacture hardware.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 60
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_carbon_gco2{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "carbon {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Runtime headroom and shedding",
      "description": "Each runtime limit as a percentage of its configured cap, on the left axis. The advisor starts hinting at 90% (red line). The right axis shows shed batches per second: when the analysis queue is full the daemon discards a whole batch rather than blocking ingestion, so those traces are never analysed and their findings never exist. Any sustained shedding means raising analysis_queue_capacity or giving the daemon more CPU.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 68
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_active_traces{job=~\"$job\"} / perf_sentinel_max_active_traces{job=~\"$job\"} * 100",
          "refId": "A",
          "legendFormat": "active_traces {{instance}}"
        },
        {
          "expr": "perf_sentinel_analysis_queue_depth{job=~\"$job\"} / perf_sentinel_analysis_queue_capacity{job=~\"$job\"} * 100",
          "refId": "B",
          "legendFormat": "analysis_queue {{instance}}"
        },
        {
