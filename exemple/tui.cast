[2.007126, "o", "m\u2502\u001b[24;1H\u2502Source:   \u001b[22mrequests.sessio\u001b[24;28Hs.CartService::enrich (inventory/enrich.py:88)\u001b[24;126H\u001b[2m\u2502\u001b[25;1H\u2502\u001b[22m\u001b[38;5;6;49mSuggestion: \u001b[39;49mUse a batch e\u001b[25;28Hdpo\u001b[25;32Hnt with ?ids=... t\u001b[25;51H batch 12 calls into one          \u001b[25;126H\u001b[2m\u2502\u001b[26;1H\u2502\u001b[22m\u001b[38;5;6;49mSuggested fix: \u001b[39;49mUse asyncio.gather\u001b[26;36H) or concurrent.futures.ThreadPoolExecutor\u001b[26;79Hfor\u001b[26;83Hparallel\u001b[26;92Hindependent\u001b[26;104Hcalls.\u001b[26;111HSwitch\u001b[26;118Hto\u001b[26;121Ha\u001b[26;126H\u001b[2m\u2502\u001b[27;1H\u2502\u001b[22mbatch endpo\u001b[27;14Hnt when the ca\u001b[27;29Hls fan out fr\u001b[27;43Hm the same upstream input.\u001b[2m (see:\u001b[27;126H\u2502\u001b[28;1H\u2502https://docs.python.org/3/library/asyncio-task.html#asyncio.gather)\u001b[28;126H\u2502\u001b[29;1H\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
