---
title: The two acknowledgment stores
---
flowchart LR
    subgraph write_toml["Writes: team decision, via PR"]
        direction TB
        gen["analyze --format json | jq<br/><i>generates the entry</i>"]
        pr["Pull request review"]
        gen --> pr
    end

    toml[(".perf-sentinel-acknowledgments.toml<br/><i>versioned in the repo</i>")]

    subgraph write_jsonl["Writes: operator, needs a running daemon"]
        direction TB
        cli["ack create"]
        tui["query inspect, key a"]
        html["Ack buttons of the live HTML<br/><i>file built by batch report --daemon-url,<br/>the click posts to the daemon</i>"]
        api["POST /api/findings/{sig}/ack"]
    end

    jsonl[("acks.jsonl<br/><i>on that daemon's disk,<br/>one per daemon</i>")]

    subgraph reads_batch["Reads: batch, no daemon involved"]
        direction TB
        gate["analyze --ci gate"]
        rep["report<br/><i>the HTML dashboard</i>"]
        base["diff baseline"]
        warn["unmatched_acknowledgment"]
    end

    daemon_reads["Reads: daemon<br/><i>/api/findings, live mode</i>"]

    pr --> toml
    cli --> jsonl
    tui --> jsonl
    html --> jsonl
    api --> jsonl

    toml --> reads_batch
    toml -- "wins on conflict" --> daemon_reads
    jsonl --> daemon_reads

    note["A daemon ack silences that daemon only.<br/>To unblock CI, put the signature in the TOML"]
    jsonl -.-> note

    style write_toml fill:#2d4a3e,stroke:#4ade80
    style write_jsonl fill:#2d3b4a,stroke:#60a5fa
    style toml fill:#2d4a3e,stroke:#4ade80
    style jsonl fill:#2d3b4a,stroke:#60a5fa
    style reads_batch fill:#3b2d4a,stroke:#a78bfa
    style note fill:#4a3b2d,stroke:#fbbf24
